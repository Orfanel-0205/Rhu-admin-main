# .env.example -- Ka-Agapay RHU admin (Vite)
#
# Copy this to .env.production before `npm run build`. That file is gitignored;
# this template is the only env file that is committed.
#
# VITE_API_URL is baked into the bundle at BUILD time. If it is missing, the
# build still succeeds and apiClient.ts silently falls back to
# http://127.0.0.1:8000/api/v1 -- every staff browser would then call its OWN
# machine. scripts/check-api-url.mjs (run automatically as prebuild/postbuild)
# refuses to build or ship that bundle.
#
# Rules the check enforces:
#   - must be https:// (the admin is served over HTTPS; http API calls are
#     blocked as mixed content)
#   - must be the public server host, not localhost / 127.x / a LAN IP
#   - must END IN /api/v1 -- unlike the mobile app, the admin uses this value
#     verbatim as its base URL and appends nothing
#
# Local development (`npm run dev`) runs in development mode, does not read
# .env.production, and uses the http://127.0.0.1:8000/api/v1 fallback, which is
# correct for a backend on your own machine.

VITE_API_URL=https://rhu-kaagapay.129-212-236-47.sslip.io/api/v1
